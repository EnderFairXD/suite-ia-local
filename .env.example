# Copia este archivo a .env y ajústalo (no subas .env al repositorio)

# Servidor de Ollama y modelo
OLLAMA_BASE_URL=http://localhost:11434
MODELO=llama3.1
# Ventana de contexto en tokens. Los textos que no caben se dividen en partes.
CONTEXTO=8192

# Modelo de Whisper para transcribir (tiny, base, small, medium...)
MODELO_WHISPER=base

# Correo (solo para la herramienta de correo). En Gmail, usa una contraseña de aplicación.
EMAIL_USER=
EMAIL_PASS=
IMAP_SERVER=imap.gmail.com
